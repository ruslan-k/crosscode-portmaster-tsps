+    cc_perf.calls[k]++;
+  }
+}
+void raster_fill_rect(Surface *dst, double x, double y, double w, double h,
+                       const Matrix *ctm, const PaintSampler *ps, const DrawParams *dp) {
+  double t = cc_perf.enabled ? cc_now() : 0;
+  cc_raster_fill_rect(dst, x, y, w, h, ctm, ps, dp);
+  if (cc_perf.enabled) cc_perf.fill_ms += cc_now() - t;
+}
--- a/runtime/gfx/ccperf.h
+++ b/runtime/gfx/ccperf.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <time.h>
+#include <stdint.h>
+#include "surface.h"
+typedef struct {
+  int enabled;
+  double draw[OP_COUNT + 1], fill_ms, image_ms, canvas_ms;
+  uint64_t calls[OP_COUNT + 1];
+} CCPerf;
+extern CCPerf cc_perf;
+static inline double cc_now(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
