 #include "raster.h"
 #include "ccperf.h"
 CCPerf cc_perf;
+#include <stdio.h>
+#include <unistd.h>
+_Thread_local int cc_reference_blend;
+static unsigned long cc_verify_calls[OP_COUNT];
+static unsigned long long cc_verify_pixels;
+static int cc_verifying(void) {
+  const char *path = getenv("CC_VERIFY_BLEND");
+  return path && access(path, F_OK) == 0;
+}
+static void cc_match(const Surface *a, Surface *b, CompositeOp op) {
+  size_t bytes = (size_t)a->w * a->h * 4;
+  if (memcmp(a->px, b->px, bytes)) {
+    fprintf(stderr, "CC_VERIFY FAIL op=%d size=%dx%d\n", op, a->w, a->h);
+    abort();
+  }
+  cc_verify_calls[op]++;
+  cc_verify_pixels += bytes / 4;
+  surface_free(b);
+}
+__attribute__((destructor)) static void cc_verify_report(void) {
+  if (!cc_verifying()) return;
+  fprintf(stderr, "CC_VERIFY PASS source-over=%lu destination-out=%lu compared-pixels=%llu\n",
+          cc_verify_calls[OP_SOURCE_OVER], cc_verify_calls[OP_DESTINATION_OUT], cc_verify_pixels);
+}
